# Copy to .env and fill in. Everything is optional — without a key the AI
# endpoints use the built-in offline fallback and the app works end to end.

# Any OpenAI-compatible provider works (OpenAI, Groq, OpenRouter, local Ollama...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20

# Frontend origin(s) allowed by CORS, comma-separated
FRONTEND_ORIGIN=http://localhost:3000

# Fill an empty database with the demo leads on startup (1/true/yes).
# Handy for fresh cloud deploys — never touches a database that has leads.
SEED_DEMO_DATA=

# Default: SQLite file. For Postgres use e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/leads
DATABASE_URL=sqlite:///./leads.db
